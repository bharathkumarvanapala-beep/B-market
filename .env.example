# ========================================================
# B MARKET BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# IMPORTANT:
# - NEVER commit your real .env file with secrets to Git.
# - The real .env file is ignored by .gitignore.
# - When deploying online (Render, Railway, Fly.io, etc.),
#   add these variables in your host's Dashboard Settings.

# Port (Cloud providers like Render / Railway set this automatically)
PORT=5000

# MongoDB Atlas Database URI (or local MongoDB)
# For online hosting, get your free connection string from MongoDB Atlas:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bmarket?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bmarket

# JWT Secret for authentication tokens (change to any secure random string)
JWT_SECRET=bmarket_jwt_secret_change_me_in_production

# Frontend Netlify URL (for CORS validation)
# Example: https://your-site-name.netlify.app
FRONTEND_URL=https://your-site-name.netlify.app

# ========================================================
# EMAIL ENQUIRIES & ORDER CONFIRMATION (GMAIL SMTP)
# ========================================================
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password:
#    https://myaccount.google.com/apppasswords
#    (Select App: Mail, Device: Windows Computer / Other)
# 3. Enter your Gmail and 16-character App Password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
